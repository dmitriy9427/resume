---
/**
 * Проекты в продакшне: фильтр по категориям (Flip-анимация, фильтр в адресе)
 * и карточки. Данные — categories и projects в src/data/resume.ts.
 * Ключевые проекты (featured) — карточки на две колонки.
 * Показываются только проекты со ссылкой (href).
 */
import { asLocale, pick, useTranslations, withBase } from '../i18n/ui'
import { categories, projects as allProjects } from '../data/resume'

const locale = asLocale(Astro.currentLocale)
const t = useTranslations(locale)
// Показываем только проекты со ссылкой на живой сайт. Закрытые (NDA, ещё не
// в проде) остаются в данных: появится ссылка — карточка покажется сама.
const projects = allProjects.filter((p) => p.href)
const used = Object.keys(categories).filter((key) => projects.some((p) => p.category === key))
---

<section class="section projects" id="projects" data-module="flip-filter">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title" data-reveal><span class="section-title__index">03</span>{t('projects.title')}</h2>
      <p class="section-head__lead muted" data-reveal>{t('projects.lead')}</p>
    </div>
    <div class="flip-filter__tabs" data-reveal>
      <button data-filter="all" aria-pressed="true">{t('projects.all')} <sup>{projects.length}</sup></button>
      {
        used.map((key) => (
          <button data-filter={key}>
            {pick(categories[key], locale)} <sup>{projects.filter((p) => p.category === key).length}</sup>
          </button>
        ))
      }
    </div>
    <div class="projects__grid" data-module="spotlight">
      {
        projects.map((project) => (
          <article
            class:list={['project spot', { 'project--featured': project.featured }]}
            data-flip-item
            data-category={project.category}
          >
            {project.image ? (
              <div class="project__media">
                <img
                  src={withBase(project.image)}
                  alt={pick(project.title, locale)}
                  width="960"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : project.cover ? (
              <div class="project__media project__cover" data-category={project.category} aria-hidden="true">
                <span class="project__cover-text">{project.cover.text}</span>
                <span class="project__cover-note">{pick(project.cover.note, locale)}</span>
              </div>
            ) : null}
            <div class="project__top">
              <span class="project__category">{pick(categories[project.category], locale)}</span>
              <span class="project__year">{project.year}</span>
            </div>
            <h3 class="project__title">{pick(project.title, locale)}</h3>
            <p class="project__text">{pick(project.description, locale)}</p>
            <ul class="chips chips--sm">
              {project.stack.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
            {project.href ? (
              <a class="project__link" href={project.href} target="_blank" rel="noopener" data-cursor={t('cursor.open')}>
                {t('projects.open')} <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="project__link project__link--nda">{t('projects.nda')}</span>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
