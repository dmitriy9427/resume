---
/**
 * ВРЕМЕННО: каркас «лаборатории» — страниц-прототипов нового дизайна резюме
 * (/lab/neon, /lab/holo, /lab/riso). Сравниваем, выбираем, победителя
 * переносим в основной сайт, а src/pages/lab, src/lab, src/styles/lab,
 * components/lab и этот файл — удаляем.
 *
 * Отдельно от Base.astro: свои стили и скрипты, основной сайт не задет.
 * noindex + исключены из sitemap (astro.config) — в поиск не попадут.
 *
 * Тема — data-theme на <html>, по умолчанию тёмная; выбор запоминается
 * отдельно для лаборатории (ключ lab-theme). Скрипты вариантов слушают
 * событие lab:theme (меняют материалы 3D-курсора).
 */
import '@fontsource-variable/unbounded'
import '@fontsource-variable/manrope'
import '@fontsource-variable/jetbrains-mono'

interface Props {
  variant: 'neon' | 'holo' | 'riso'
  title: string
}

const { variant, title } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const VARIANTS = [
  { id: 'neon', label: 'A · Неон и стекло' },
  { id: 'holo', label: 'B · Голограмма' },
  { id: 'riso', label: 'C · Вывеска и ризограф' },
]
---

<!doctype html>
<html lang="ru" class={`lab lab--${variant}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — лаборатория дизайна</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        var t = JSON.parse(localStorage.getItem('lab-theme'))
        document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark'
      } catch (e) {
        document.documentElement.dataset.theme = 'dark'
      }
    </script>
  </head>
  <body>
    <nav class="lab-switcher" aria-label="Варианты дизайна">
      <span class="lab-switcher__tag">Прототипы</span>
      {
        VARIANTS.map((v) => (
          <a
            class="lab-switcher__link"
            href={`${base}/lab/${v.id}`}
            aria-current={v.id === variant ? 'page' : undefined}
          >
            {v.label}
          </a>
        ))
      }
      <button class="lab-switcher__theme" type="button" data-lab-theme aria-label="Сменить тему">
        <span class="lab-switcher__theme-dark">Ночь</span>
        <span class="lab-switcher__theme-light">День</span>
      </button>
    </nav>
    <slot />
  </body>
</html>
